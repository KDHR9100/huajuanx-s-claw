[
  {"n": 1, "bin": "111111", "name": "乾为天", "gong": "乾宫·金", "ci": "元、亨、利、贞。"},
  {"n": 2, "bin": "000000", "name": "坤为地", "gong": "坤宫·土", "ci": "元亨，利牝马之贞。君子有攸往，先迷后得主。利西南得朋，东北丧朋。安贞吉。"},
  {"n": 3, "bin": "100010", "name": "水雷屯", "gong": "坎宫·水", "ci": "元亨利贞。勿用有攸往，利建侯。"},
  {"n": 4, "bin": "010001", "name": "山水蒙", "gong": "离宫·火", "ci": "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。"},
  {"n": 5, "bin": "111010", "name": "水天需", "gong": "坤宫·土", "ci": "有孚，光亨，贞吉。利涉大川。"},
  {"n": 6, "bin": "010111", "name": "天水讼", "gong": "离宫·火", "ci": "有孚窒惕，中吉，终凶。利见大人，不利涉大川。"},
  {"n": 7, "bin": "010000", "name": "地水师", "gong": "坎宫·水", "ci": "贞，丈人吉，无咎。"},
  {"n": 8, "bin": "000010", "name": "水地比", "gong": "坤宫·土", "ci": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。"},
  {"n": 9, "bin": "111011", "name": "风天小畜", "gong": "巽宫·木", "ci": "亨。密云不雨，自我西郊。"},
  {"n": 10, "bin": "110111", "name": "天泽履", "gong": "艮宫·土", "ci": "履虎尾，不咥人，亨。"},
  {"n": 11, "bin": "111000", "name": "地天泰", "gong": "坤宫·土", "ci": "小往大来，吉，亨。"},
  {"n": 12, "bin": "000111", "name": "天地否", "gong": "乾宫·金", "ci": "否之匪人，不利君子贞，大往小来。"},
  {"n": 13, "bin": "101111", "name": "天火同人", "gong": "离宫·火", "ci": "同人于野，亨。利涉大川，利君子贞。"},
  {"n": 14, "bin": "111101", "name": "火天大有", "gong": "乾宫·金", "ci": "元亨。"},
  {"n": 15, "bin": "001000", "name": "地山谦", "gong": "兑宫·金", "ci": "亨。君子有终。"},
  {"n": 16, "bin": "000100", "name": "雷地豫", "gong": "震宫·木", "ci": "利建侯行师。"},
  {"n": 17, "bin": "100110", "name": "泽雷随", "gong": "震宫·木", "ci": "元亨利贞，无咎。"},
  {"n": 18, "bin": "011001", "name": "山风蛊", "gong": "巽宫·木", "ci": "元亨，利涉大川。先甲三日，后甲三日。"},
  {"n": 19, "bin": "110000", "name": "地泽临", "gong": "坤宫·土", "ci": "元亨利贞。至于八月有凶。"},
  {"n": 20, "bin": "000011", "name": "风地观", "gong": "乾宫·金", "ci": "盥而不荐，有孚颙若。"},
  {"n": 21, "bin": "100101", "name": "火雷噬嗑", "gong": "巽宫·木", "ci": "亨。利用狱。"},
  {"n": 22, "bin": "101001", "name": "山火贲", "gong": "艮宫·土", "ci": "亨。小利有攸往。"},
  {"n": 23, "bin": "000001", "name": "山地剥", "gong": "乾宫·金", "ci": "不利有攸往。"},
  {"n": 24, "bin": "100000", "name": "地雷复", "gong": "坤宫·土", "ci": "亨。出入无疾，朋来无咎。反复其道，七日来复。利有攸往。"},
  {"n": 25, "bin": "100111", "name": "天雷无妄", "gong": "巽宫·木", "ci": "元亨利贞。其匪正有眚，不利有攸往。"},
  {"n": 26, "bin": "111001", "name": "山天大畜", "gong": "艮宫·土", "ci": "利贞。不家食吉，利涉大川。"},
  {"n": 27, "bin": "100001", "name": "山雷颐", "gong": "巽宫·木", "ci": "贞吉。观颐，自求口实。"},
  {"n": 28, "bin": "011110", "name": "泽风大过", "gong": "震宫·木", "ci": "栋桡。利有攸往，亨。"},
  {"n": 29, "bin": "010010", "name": "坎为水", "gong": "坎宫·水", "ci": "习坎，有孚，维心亨，行有尚。"},
  {"n": 30, "bin": "101101", "name": "离为火", "gong": "离宫·火", "ci": "利贞，亨。畜牝牛吉。"},
  {"n": 31, "bin": "001110", "name": "泽山咸", "gong": "兑宫·金", "ci": "亨，利贞。取女吉。"},
  {"n": 32, "bin": "011100", "name": "雷风恒", "gong": "震宫·木", "ci": "亨，无咎，利贞。利有攸往。"},
  {"n": 33, "bin": "001111", "name": "天山遁", "gong": "乾宫·金", "ci": "亨。小利贞。"},
  {"n": 34, "bin": "111100", "name": "雷天大壮", "gong": "坤宫·土", "ci": "利贞。"},
  {"n": 35, "bin": "000101", "name": "火地晋", "gong": "乾宫·金", "ci": "康侯用锡马蕃庶，昼日三接。"},
  {"n": 36, "bin": "101000", "name": "地火明夷", "gong": "坎宫·水", "ci": "利艰贞。"},
  {"n": 37, "bin": "101011", "name": "风火家人", "gong": "巽宫·木", "ci": "利女贞。"},
  {"n": 38, "bin": "110101", "name": "火泽睽", "gong": "艮宫·土", "ci": "小事吉。"},
  {"n": 39, "bin": "001010", "name": "水山蹇", "gong": "兑宫·金", "ci": "利西南，不利东北。利见大人，贞吉。"},
  {"n": 40, "bin": "010100", "name": "雷水解", "gong": "震宫·木", "ci": "利西南。无所往，其来复吉。有攸往，夙吉。"},
  {"n": 41, "bin": "110001", "name": "山泽损", "gong": "艮宫·土", "ci": "有孚，元吉，无咎，可贞。利有攸往。曷之用？二簋可用享。"},
  {"n": 42, "bin": "100011", "name": "风雷益", "gong": "巽宫·木", "ci": "利有攸往，利涉大川。"},
  {"n": 43, "bin": "111110", "name": "泽天夬", "gong": "坤宫·土", "ci": "扬于王庭，孚号有厉。告自邑，不利即戎，利有攸往。"},
  {"n": 44, "bin": "011111", "name": "天风姤", "gong": "乾宫·金", "ci": "女壮，勿用取女。"},
  {"n": 45, "bin": "000110", "name": "泽地萃", "gong": "兑宫·金", "ci": "亨。王假有庙，利见大人。亨，利贞。用大牲吉，利有攸往。"},
  {"n": 46, "bin": "011000", "name": "地风升", "gong": "震宫·木", "ci": "元亨。用见大人，勿恤。南征吉。"},
  {"n": 47, "bin": "010110", "name": "泽水困", "gong": "兑宫·金", "ci": "亨，贞，大人吉，无咎。有言不信。"},
  {"n": 48, "bin": "011010", "name": "水风井", "gong": "震宫·木", "ci": "改邑不改井，无丧无得，往来井井。汔至亦未繘井，羸其瓶，凶。"},
  {"n": 49, "bin": "101110", "name": "泽火革", "gong": "坎宫·水", "ci": "巳日乃孚，元亨利贞，悔亡。"},
  {"n": 50, "bin": "011101", "name": "火风鼎", "gong": "离宫·火", "ci": "元吉，亨。"},
  {"n": 51, "bin": "100100", "name": "震为雷", "gong": "震宫·木", "ci": "亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。"},
  {"n": 52, "bin": "001001", "name": "艮为山", "gong": "艮宫·土", "ci": "艮其背，不获其身；行其庭，不见其人。无咎。"},
  {"n": 53, "bin": "001011", "name": "风山渐", "gong": "艮宫·土", "ci": "女归吉，利贞。"},
  {"n": 54, "bin": "110100", "name": "雷泽归妹", "gong": "兑宫·金", "ci": "征凶，无攸利。"},
  {"n": 55, "bin": "101100", "name": "雷火丰", "gong": "坎宫·水", "ci": "亨。王假之，勿忧，宜日中。"},
  {"n": 56, "bin": "001101", "name": "火山旅", "gong": "离宫·火", "ci": "小亨，旅贞吉。"},
  {"n": 57, "bin": "011011", "name": "巽为风", "gong": "巽宫·木", "ci": "小亨。利有攸往，利见大人。"},
  {"n": 58, "bin": "110110", "name": "兑为泽", "gong": "兑宫·金", "ci": "亨，利贞。"},
  {"n": 59, "bin": "010011", "name": "风水涣", "gong": "离宫·火", "ci": "亨。王假有庙，利涉大川，利贞。"},
  {"n": 60, "bin": "110010", "name": "水泽节", "gong": "坎宫·水", "ci": "亨。苦节不可贞。"},
  {"n": 61, "bin": "110011", "name": "风泽中孚", "gong": "艮宫·土", "ci": "豚鱼吉，利涉大川，利贞。"},
  {"n": 62, "bin": "001100", "name": "雷山小过", "gong": "兑宫·金", "ci": "亨，利贞。可小事，不可大事。飞鸟遗之音，不宜上，宜下，大吉。"},
  {"n": 63, "bin": "101010", "name": "水火既济", "gong": "坎宫·水", "ci": "亨小，利贞。初吉终乱。"},
  {"n": 64, "bin": "010101", "name": "火水未济", "gong": "离宫·火", "ci": "亨。小狐汔济，濡其尾，无攸利。"}
